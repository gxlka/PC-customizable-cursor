HKCU,"Control Panel\Cursors","AppStarting",0x00000000,"%10%\Cursors\Pen-Black\Pen-Black-appstarting.ani"
HKCU,"Control Panel\Cursors","Wait",0x00000000,"%10%\Cursors\Pen-Black\Pen-Black-wait.ani"
HKCU,"Control Panel\Cursors","Crosshair",0x00000000,"%10%\Cursors\Pen-Black\Pen-Black-crosshair.ani"
HKCU,"Control Panel\Cursors","IBeam",0x00000000,"%10%\Cursors\Pen-Black\Pen-Black-ibeam.ani"
HKCU,"Control Panel\Cursors","NWPen",0x00000000,"%10%\Cursors\Pen-Black\Pen-Black-nwpen.ani"
HKCU,"Control Panel\Cursors","No",0x00000000,"%10%\Cursors\Pen-Black\Pen-Black-no.ani"
HKCU,"Control Panel\Cursors","SizeNS",0x00000000,"%10%\Cursors\Pen-Black\Pen-Black-sizens.ani"
HKCU,"Control Panel\Cursors","SizeWE",0x00000000,"%10%\Cursors\Pen-Black\Pen-Black-sizewe.ani"
