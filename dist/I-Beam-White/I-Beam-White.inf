I-Beam-White-sizeall.ani
I-Beam-White-uparrow.ani
I-Beam-White-hand.ani
I-Beam-White-pin.ani
I-Beam-White-person.ani

[CursorScheme]
HKCU,"Control Panel\Cursors\Schemes","%SchemeName%",0x00000000,"%10%\Cursors\I-Beam-White\I-Beam-White-arrow.ani,%10%\Cursors\I-Beam-White\I-Beam-White-help.ani,%10%\Cursors\I-Beam-White\I-Beam-White-appstarting.ani,%10%\Cursors\I-Beam-White\I-Beam-White-wait.ani,%10%\Cursors\I-Beam-White\I-Beam-White-crosshair.ani,%10%\Cursors\I-Beam-White\I-Beam-White-ibeam.ani,%10%\Cursors\I-Beam-White\I-Beam-White-nwpen.ani,%10%\Cursors\I-Beam-White\I-Beam-White-no.ani,%10%\Cursors\I-Beam-White\I-Beam-White-sizens.ani,%10%\Cursors\I-Beam-White\I-Beam-White-sizewe.ani,%10%\Cursors\I-Beam-White\I-Beam-White-sizenwse.ani,%10%\Cursors\I-Beam-White\I-Beam-White-sizenesw.ani,%10%\Cursors\I-Beam-White\I-Beam-White-sizeall.ani,%10%\Cursors\I-Beam-White\I-Beam-White-uparrow.ani,%10%\Cursors\I-Beam-White\I-Beam-White-hand.ani,%10%\Cursors\I-Beam-White\I-Beam-White-pin.ani,%10%\Cursors\I-Beam-White\I-Beam-White-person.ani"

