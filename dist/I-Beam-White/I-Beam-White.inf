I-Beam-White-uparrow.ani=1
I-Beam-White-hand.ani=1
I-Beam-White-pin.ani=1
I-Beam-White-person.ani=1

[DestinationDirs]
CursorFiles=10,"Cursors\I-Beam-White"

[CursorFiles]
I-Beam-White-arrow.ani
I-Beam-White-help.ani
I-Beam-White-appstarting.ani
I-Beam-White-wait.ani
I-Beam-White-crosshair.ani
I-Beam-White-ibeam.ani
