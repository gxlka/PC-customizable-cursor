[Version]
Signature="$Windows NT$"

[DefaultInstall]
CopyFiles=CursorFiles
AddReg=CursorScheme,ActiveCursors

[SourceDisksNames]
1=%DiskName%,,,.

[SourceDisksFiles]
I-Beam-White-arrow.ani=1
I-Beam-White-help.ani=1
I-Beam-White-appstarting.ani=1
I-Beam-White-wait.ani=1
I-Beam-White-crosshair.ani=1
I-Beam-White-ibeam.ani=1
