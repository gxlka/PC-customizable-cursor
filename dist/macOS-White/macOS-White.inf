[Version]
Signature="$Windows NT$"

[DefaultInstall]
CopyFiles=CursorFiles
AddReg=CursorScheme,ActiveCursors

[SourceDisksNames]
1=%DiskName%,,,.

[SourceDisksFiles]
macOS-White-arrow.cur=1
macOS-White-help.cur=1
macOS-White-appstarting.ani=1
macOS-White-wait.ani=1
macOS-White-crosshair.cur=1
macOS-White-ibeam.cur=1
macOS-White-nwpen.cur=1
macOS-White-no.cur=1
macOS-White-sizens.cur=1
macOS-White-sizewe.cur=1
macOS-White-sizenwse.cur=1
macOS-White-sizenesw.cur=1
macOS-White-sizeall.cur=1
macOS-White-uparrow.cur=1
macOS-White-hand.cur=1
macOS-White-pin.cur=1
macOS-White-person.cur=1

[DestinationDirs]
CursorFiles=10,"Cursors\macOS-White"

[CursorFiles]
macOS-White-arrow.cur
macOS-White-help.cur
macOS-White-appstarting.ani
macOS-White-wait.ani
macOS-White-crosshair.cur
macOS-White-ibeam.cur
macOS-White-nwpen.cur
macOS-White-no.cur
macOS-White-sizens.cur
macOS-White-sizewe.cur
macOS-White-sizenwse.cur
macOS-White-sizenesw.cur
macOS-White-sizeall.cur
macOS-White-uparrow.cur
macOS-White-hand.cur
macOS-White-pin.cur
macOS-White-person.cur

[CursorScheme]
HKCU,"Control Panel\Cursors\Schemes","%SchemeName%",0x00000000,"%10%\Cursors\macOS-White\macOS-White-arrow.cur,%10%\Cursors\macOS-White\macOS-White-help.cur,%10%\Cursors\macOS-White\macOS-White-appstarting.ani,%10%\Cursors\macOS-White\macOS-White-wait.ani,%10%\Cursors\macOS-White\macOS-White-crosshair.cur,%10%\Cursors\macOS-White\macOS-White-ibeam.cur,%10%\Cursors\macOS-White\macOS-White-nwpen.cur,%10%\Cursors\macOS-White\macOS-White-no.cur,%10%\Cursors\macOS-White\macOS-White-sizens.cur,%10%\Cursors\macOS-White\macOS-White-sizewe.cur,%10%\Cursors\macOS-White\macOS-White-sizenwse.cur,%10%\Cursors\macOS-White\macOS-White-sizenesw.cur,%10%\Cursors\macOS-White\macOS-White-sizeall.cur,%10%\Cursors\macOS-White\macOS-White-uparrow.cur,%10%\Cursors\macOS-White\macOS-White-hand.cur,%10%\Cursors\macOS-White\macOS-White-pin.cur,%10%\Cursors\macOS-White\macOS-White-person.cur"

[ActiveCursors]
HKCU,"Control Panel\Cursors",,0x00000000,"%SchemeName%"
HKCU,"Control Panel\Cursors","Scheme Source",0x00010001,1
HKCU,"Control Panel\Cursors","Arrow",0x00000000,"%10%\Cursors\macOS-White\macOS-White-arrow.cur"
HKCU,"Control Panel\Cursors","Help",0x00000000,"%10%\Cursors\macOS-White\macOS-White-help.cur"
HKCU,"Control Panel\Cursors","AppStarting",0x00000000,"%10%\Cursors\macOS-White\macOS-White-appstarting.ani"
HKCU,"Control Panel\Cursors","Wait",0x00000000,"%10%\Cursors\macOS-White\macOS-White-wait.ani"
HKCU,"Control Panel\Cursors","Crosshair",0x00000000,"%10%\Cursors\macOS-White\macOS-White-crosshair.cur"
HKCU,"Control Panel\Cursors","IBeam",0x00000000,"%10%\Cursors\macOS-White\macOS-White-ibeam.cur"
HKCU,"Control Panel\Cursors","NWPen",0x00000000,"%10%\Cursors\macOS-White\macOS-White-nwpen.cur"
HKCU,"Control Panel\Cursors","No",0x00000000,"%10%\Cursors\macOS-White\macOS-White-no.cur"
HKCU,"Control Panel\Cursors","SizeNS",0x00000000,"%10%\Cursors\macOS-White\macOS-White-sizens.cur"
HKCU,"Control Panel\Cursors","SizeWE",0x00000000,"%10%\Cursors\macOS-White\macOS-White-sizewe.cur"
HKCU,"Control Panel\Cursors","SizeNWSE",0x00000000,"%10%\Cursors\macOS-White\macOS-White-sizenwse.cur"
HKCU,"Control Panel\Cursors","SizeNESW",0x00000000,"%10%\Cursors\macOS-White\macOS-White-sizenesw.cur"
HKCU,"Control Panel\Cursors","SizeAll",0x00000000,"%10%\Cursors\macOS-White\macOS-White-sizeall.cur"
HKCU,"Control Panel\Cursors","UpArrow",0x00000000,"%10%\Cursors\macOS-White\macOS-White-uparrow.cur"
HKCU,"Control Panel\Cursors","Hand",0x00000000,"%10%\Cursors\macOS-White\macOS-White-hand.cur"
HKCU,"Control Panel\Cursors","Pin",0x00000000,"%10%\Cursors\macOS-White\macOS-White-pin.cur"
HKCU,"Control Panel\Cursors","Person",0x00000000,"%10%\Cursors\macOS-White\macOS-White-person.cur"

[Strings]
DiskName="macOS White Cursor Pack"
SchemeName="macOS White"
