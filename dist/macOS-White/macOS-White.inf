[Version]
Signature="$Windows NT$"

[DefaultInstall]
CopyFiles=CursorFiles
AddReg=CursorScheme,ActiveCursors

[SourceDisksNames]
1=%DiskName%,,,.

[SourceDisksFiles]
macOS-White-arrow.ani=1
macOS-White-help.ani=1
macOS-White-appstarting.ani=1
macOS-White-wait.ani=1
macOS-White-crosshair.ani=1
macOS-White-ibeam.ani=1
macOS-White-nwpen.ani=1
macOS-White-no.ani=1
macOS-White-sizens.ani=1
macOS-White-sizewe.ani=1
macOS-White-sizenwse.ani=1
macOS-White-sizenesw.ani=1
macOS-White-sizeall.ani=1
macOS-White-uparrow.ani=1
macOS-White-hand.ani=1
macOS-White-pin.ani=1
macOS-White-person.ani=1

[DestinationDirs]
CursorFiles=10,"Cursors\macOS-White"

[CursorFiles]
macOS-White-arrow.ani
macOS-White-help.ani
macOS-White-appstarting.ani
macOS-White-wait.ani
macOS-White-crosshair.ani
macOS-White-ibeam.ani
macOS-White-nwpen.ani
macOS-White-no.ani
macOS-White-sizens.ani
macOS-White-sizewe.ani
macOS-White-sizenwse.ani
macOS-White-sizenesw.ani
macOS-White-sizeall.ani
macOS-White-uparrow.ani
macOS-White-hand.ani
macOS-White-pin.ani
macOS-White-person.ani

[CursorScheme]
HKCU,"Control Panel\Cursors\Schemes","%SchemeName%",0x00000000,"%10%\Cursors\macOS-White\macOS-White-arrow.ani,%10%\Cursors\macOS-White\macOS-White-help.ani,%10%\Cursors\macOS-White\macOS-White-appstarting.ani,%10%\Cursors\macOS-White\macOS-White-wait.ani,%10%\Cursors\macOS-White\macOS-White-crosshair.ani,%10%\Cursors\macOS-White\macOS-White-ibeam.ani,%10%\Cursors\macOS-White\macOS-White-nwpen.ani,%10%\Cursors\macOS-White\macOS-White-no.ani,%10%\Cursors\macOS-White\macOS-White-sizens.ani,%10%\Cursors\macOS-White\macOS-White-sizewe.ani,%10%\Cursors\macOS-White\macOS-White-sizenwse.ani,%10%\Cursors\macOS-White\macOS-White-sizenesw.ani,%10%\Cursors\macOS-White\macOS-White-sizeall.ani,%10%\Cursors\macOS-White\macOS-White-uparrow.ani,%10%\Cursors\macOS-White\macOS-White-hand.ani,%10%\Cursors\macOS-White\macOS-White-pin.ani,%10%\Cursors\macOS-White\macOS-White-person.ani"

[ActiveCursors]
HKCU,"Control Panel\Cursors",,0x00000000,"%SchemeName%"
HKCU,"Control Panel\Cursors","Scheme Source",0x00010001,1
HKCU,"Control Panel\Cursors","Arrow",0x00000000,"%10%\Cursors\macOS-White\macOS-White-arrow.ani"
HKCU,"Control Panel\Cursors","Help",0x00000000,"%10%\Cursors\macOS-White\macOS-White-help.ani"
HKCU,"Control Panel\Cursors","AppStarting",0x00000000,"%10%\Cursors\macOS-White\macOS-White-appstarting.ani"
HKCU,"Control Panel\Cursors","Wait",0x00000000,"%10%\Cursors\macOS-White\macOS-White-wait.ani"
HKCU,"Control Panel\Cursors","Crosshair",0x00000000,"%10%\Cursors\macOS-White\macOS-White-crosshair.ani"
HKCU,"Control Panel\Cursors","IBeam",0x00000000,"%10%\Cursors\macOS-White\macOS-White-ibeam.ani"
HKCU,"Control Panel\Cursors","NWPen",0x00000000,"%10%\Cursors\macOS-White\macOS-White-nwpen.ani"
HKCU,"Control Panel\Cursors","No",0x00000000,"%10%\Cursors\macOS-White\macOS-White-no.ani"
HKCU,"Control Panel\Cursors","SizeNS",0x00000000,"%10%\Cursors\macOS-White\macOS-White-sizens.ani"
HKCU,"Control Panel\Cursors","SizeWE",0x00000000,"%10%\Cursors\macOS-White\macOS-White-sizewe.ani"
HKCU,"Control Panel\Cursors","SizeNWSE",0x00000000,"%10%\Cursors\macOS-White\macOS-White-sizenwse.ani"
HKCU,"Control Panel\Cursors","SizeNESW",0x00000000,"%10%\Cursors\macOS-White\macOS-White-sizenesw.ani"
HKCU,"Control Panel\Cursors","SizeAll",0x00000000,"%10%\Cursors\macOS-White\macOS-White-sizeall.ani"
HKCU,"Control Panel\Cursors","UpArrow",0x00000000,"%10%\Cursors\macOS-White\macOS-White-uparrow.ani"
HKCU,"Control Panel\Cursors","Hand",0x00000000,"%10%\Cursors\macOS-White\macOS-White-hand.ani"
HKCU,"Control Panel\Cursors","Pin",0x00000000,"%10%\Cursors\macOS-White\macOS-White-pin.ani"
